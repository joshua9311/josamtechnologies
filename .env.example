# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Custom PostgreSQL Connection URI (e.g. Aiven, Supabase, Neon, or custom PostgreSQL)
# Example format: postgres://avnadmin:yourpassword@pg-project-name.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=""

# Cloud SQL PostgreSQL Connection Variables (Automatically injected by AI Studio Cloud SQL runtime)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Admin Authentication & Security Secrets
SESSION_SECRET="your-super-secure-session-secret-key-min-32-chars"
JWT_SECRET="your-jwt-auth-token-secret-key-min-32-chars"
ADMIN_EMAIL="admin@josamtech.com"
ADMIN_PASSWORD="ChangeMeSecure123!"
